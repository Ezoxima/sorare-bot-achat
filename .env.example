# Copier en .env (gitignoré) et remplir.
#
# Le jeton JWT n'a PAS sa place ici : il vit dans le gestionnaire d'identifiants
# Windows (voir acheteur/auth/jeton.py), jamais dans un fichier. Un fichier
# traîne dans les sauvegardes et les partages d'écran ; ici c'est de l'argent.

# Clé API Sorare — couvre les données publiques (lecture seule).
SORARE_API_KEY=

# Audience du JWT (header JWT-AUD), doit matcher l'aud demandé à la connexion.
SORARE_JWT_AUD=acheteur

# URL SQLAlchemy de la base locale (SQLite par défaut, pas de serveur à gérer).
DATABASE_URL=sqlite:///./acheteur.db

# Simulation par défaut. Le bot y revient à CHAQUE redémarrage, quelle que soit
# cette valeur : le mode réel se déverrouille en ligne de commande, pas ici.
MODE_SIMULATION=true

# Mail d'approbation (lot L9). SMTP_HOST vide = mail désactivé (le fichier de
# propositions reste écrit quand même, il fait foi). Exemple pour Gmail :
# un mot de passe d'application (myaccount.google.com/apppasswords), jamais
# le mot de passe du compte Google lui-même.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_EXPEDITEUR=
SMTP_DESTINATAIRE=
SMTP_USE_TLS=true
